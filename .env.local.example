# Database
DATABASE_URL=postgresql://aisdr:password@localhost:5432/aisdr

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# AI Service
ANTHROPIC_API_KEY=sk-ant-xxx
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=dev_secret_change_in_prod

# Lead enrichment (Hunter.io)
# Grab a key from https://hunter.io/api_keys — free tier gives 25
# searches/month; paid tiers start at 500/month. When this is unset the
# Prospecting Agent falls back to Claude-synthesised leads (demo mode).
HUNTER_API_KEY=xxx

# Lead enrichment (Apollo.io)
# Grab a key from https://app.apollo.io/#/settings/integrations/api_keys
# 300M+ contact database. When set, Apollo is tried BEFORE Hunter; Hunter
# becomes the fallback. When unset, falls back to Hunter only.
APOLLO_API_KEY=xxx

# Web research (Serper.dev)
# Grab a key from https://serper.dev/api-key — free tier gives 2,500
# searches. Powers the Research Agent's real news / funding hooks per
# lead. When unset the agent falls back to LLM-plausible hooks.
SERPER_API_KEY=xxx

# Meeting booking (Cal.com)
# Grab an API key from cal.com/settings/developer/api-keys. Powers the
# Meeting Booker Agent's real booking links. When unset the agent falls
# back to the user's users.calendar_link (settable from Settings) and
# then to plain-text time proposals.
CALCOM_API_KEY=xxx

# Redis
UPSTASH_REDIS_REST_URL=redis://localhost:6379
UPSTASH_REDIS_REST_TOKEN=local

# Google (Gmail + Calendar)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail

# LinkedIn (Unipile API)
# Sign up at https://unipile.com — provides LinkedIn automation without
# violating TOS. Handles connection requests, DMs, profile views.
UNIPILE_API_KEY=xxx
UNIPILE_DSN=xxx

# LinkedIn (PhantomBuster) — legacy, optional
PHANTOMBUSTER_API_KEY=xxx
PHANTOMBUSTER_NETWORK_BOOSTER_ID=xxx
PHANTOMBUSTER_MESSAGE_SENDER_ID=xxx

# WhatsApp (Twilio)
# Create a Twilio account at https://twilio.com, enable WhatsApp sandbox
# or purchase a WhatsApp-enabled number.
TWILIO_ACCOUNT_SID=xxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_WHATSAPP_NUMBER=xxx

# SMS (Twilio)
# Same Twilio account as WhatsApp. Purchase an SMS-enabled phone number.
TWILIO_PHONE_NUMBER=xxx

# Voice Calls (Twilio + ElevenLabs)
# ElevenLabs provides AI voice synthesis for natural-sounding calls.
ELEVENLABS_API_KEY=xxx

# WhatsApp (Meta Cloud API) — legacy, optional
WHATSAPP_ACCESS_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_WEBHOOK_VERIFY_TOKEN=xxx

# HubSpot CRM
# Create a private app at https://developers.hubspot.com/docs/api/private-apps
# Scopes needed: contacts, deals, timeline
HUBSPOT_API_KEY=xxx

# Salesforce CRM
# Create a Connected App in Salesforce Setup → App Manager.
# OAuth scopes: api, refresh_token, offline_access
SALESFORCE_CLIENT_ID=xxx
SALESFORCE_CLIENT_SECRET=xxx
SALESFORCE_INSTANCE_URL=xxx

# Website Visitor Tracking (Clearbit Reveal)
# Powers IP → company identification for anonymous website visitors.
CLEARBIT_API_KEY=xxx

# Email Warmup
# Comma-separated list of warmup pool email addresses and their passwords.
# These send warm-up emails to each other to build sender reputation.
WARMUP_POOL_EMAILS=xxx
WARMUP_POOL_PASSWORDS=xxx

# Payments — India
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# Payments — US/International (PayPal Smart Buttons)
# Create a REST app at https://developer.paypal.com/dashboard/applications/live
# and copy the same Client ID into both vars (server + client). Secret is
# server-only; never expose it via NEXT_PUBLIC_*.
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxx
# "sandbox" for testing against developer.paypal.com's sandbox accounts,
# "live" for real charges. Default in code is "live".
PAYPAL_ENV=sandbox

# Storage (Cloudflare R2)
CLOUDFLARE_R2_ACCOUNT_ID=xxx
CLOUDFLARE_R2_ACCESS_KEY_ID=xxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxx
CLOUDFLARE_R2_BUCKET_NAME=aisdr-files

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
SENTRY_DSN=https://xxx@sentry.io/xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENVIRONMENT=development

# Cron security
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` with
# every cron invocation. Set this to a long random string in production
# so external callers cannot trigger /api/agents/handle-replies or other
# cron endpoints. Without it the endpoint accepts any request.
# Generate: openssl rand -hex 32
CRON_SECRET=xxx

# Database
DATABASE_URL=postgresql://aisdr:password@localhost:5432/aisdr

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# AI Service
ANTHROPIC_API_KEY=sk-ant-xxx
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=dev_secret_change_in_prod

# Lead enrichment (Hunter.io)
# Grab a key from https://hunter.io/api_keys — free tier gives 25
# searches/month; paid tiers start at 500/month. When this is unset the
# Prospecting Agent falls back to Claude-synthesised leads (demo mode).
HUNTER_API_KEY=xxx

# Redis
UPSTASH_REDIS_REST_URL=redis://localhost:6379
UPSTASH_REDIS_REST_TOKEN=local

# Google (Gmail + Calendar)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail

# LinkedIn (PhantomBuster)
PHANTOMBUSTER_API_KEY=xxx
PHANTOMBUSTER_NETWORK_BOOSTER_ID=xxx
PHANTOMBUSTER_MESSAGE_SENDER_ID=xxx

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_WEBHOOK_VERIFY_TOKEN=xxx

# Payments — India
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# Payments — US/International (PayPal Smart Buttons)
# Create a REST app at https://developer.paypal.com/dashboard/applications/live
# and copy the same Client ID into both vars (server + client). Secret is
# server-only; never expose it via NEXT_PUBLIC_*.
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxx
# "sandbox" for testing against developer.paypal.com's sandbox accounts,
# "live" for real charges. Default in code is "live".
PAYPAL_ENV=sandbox

# Storage (Cloudflare R2)
CLOUDFLARE_R2_ACCOUNT_ID=xxx
CLOUDFLARE_R2_ACCESS_KEY_ID=xxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxx
CLOUDFLARE_R2_BUCKET_NAME=aisdr-files

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
SENTRY_DSN=https://xxx@sentry.io/xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENVIRONMENT=development
